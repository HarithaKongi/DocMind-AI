APP_NAME=DocMind AI API
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# DocMind AI Supabase project only
SUPABASE_URL=
SUPABASE_KEY=

# Gemini Embedding 2
GEMINI_EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-2:batchEmbedContents
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536

# Hosted LLM provider
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
